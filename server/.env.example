# L'application — configuration serveur. Copier en .env et remplacer toutes les valeurs.
#   openssl rand -hex 32

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-superuser
AUTHENTICATOR_PASSWORD=changeme-authenticator

# --- PostgREST --------------------------------------------------------------
# Secret JWT : il signe les jetons d'administration (make admin-add). C'est le seul rempart
# entre Internet et le rôle `admin_api` — à traiter comme un mot de passe root. Le changer
# révoque tous les jetons émis d'un coup.
PGRST_JWT_SECRET=changeme-au-moins-32-caracteres-aleatoires

# --- Caddy ------------------------------------------------------------------
# Domaine public de l'API et des tuiles. En local, laisser localhost : Caddy servira
# en HTTP interne sans tenter d'obtenir un certificat.
SITE_DOMAIN=localhost
# Console d'administration (§4.3), sur un sous-domaine distinct du site public.
ADMIN_DOMAIN=admin.localhost
